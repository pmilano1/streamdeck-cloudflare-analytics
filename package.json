{
  "name": "com.milanese.cloudflare-analytics",
  "version": "1.0.0",
  "description": "Stream Deck plugin to display real-time Cloudflare analytics",
  "main": "bin/plugin.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.milanese.cloudflare-analytics\"",
    "dev": "npm run watch"
  },
  "keywords": [
    "stream-deck",
    "cloudflare",
    "analytics",
    "monitoring",
    "elgato"
  ],
  "author": "Peter Milanese",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmilano1/streamdeck-cloudflare-analytics.git"
  },
  "dependencies": {
    "@elgato/streamdeck": "^1.0.0",
    "node-fetch": "^3.3.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.11.5",
    "rollup": "^4.9.6",
    "typescript": "^5.3.3"
  },
  "homepage": "https://github.com/pmilano1/streamdeck-cloudflare-analytics#readme",
  "bugs": {
    "url": "https://github.com/pmilano1/streamdeck-cloudflare-analytics/issues"
  }
}
